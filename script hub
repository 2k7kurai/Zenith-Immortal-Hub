local UNIVERSAL_URL =
    "https://raw.githubusercontent.com/2k7kurai/Zenith-Ft-Reach-art/refs/heads/main/universal%20script"



local function notify(text)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Zenith Hub",
            Text = text,
            Duration = 5
        })
    end)
end

local function loadScript(url, scriptName)
    scriptName = scriptName or "Script"

    print("[Zenith Hub] Loading:", scriptName)
    print("[Zenith Hub] URL:", url)

    notify("Loading " .. scriptName)

    local success, result = pcall(function()
        return game:HttpGet(url)
    end)

    if not success or not result then
        warn("[Zenith Hub] Failed to fetch script:", result)
        notify("Failed to fetch script")
        return
    end

    if result:sub(1, 1) == "<" then
        warn("[Zenith Hub] Got HTML instead of raw script.")
        notify("Invalid raw GitHub URL")
        return
    end

    local func, err = loadstring(result)

    if not func then
        warn("[Zenith Hub] Loadstring error:", err)
        notify("Loadstring failed")
        return
    end

    local ran, runtimeErr = pcall(func)

    if not ran then
        warn("[Zenith Hub] Runtime error:", runtimeErr)
        notify("Runtime error")
        return
    end

    notify("Loaded " .. scriptName)
end



local function showSelectionUI(scriptList)
    local gui = Instance.new("ScreenGui")
    gui.Name = "ZenithScriptSelector"
    gui.ResetOnSpawn = false
    gui.Parent = player:WaitForChild("PlayerGui")

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 320, 0, (#scriptList * 45) + 70)
    frame.Position = UDim2.new(0.5, -160, 0.5, -((#scriptList * 45) + 70)/2)
    frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    frame.BorderSizePixel = 0
    frame.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = frame

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 40)
    title.BackgroundTransparency = 1
    title.Text = "Choose a Script"
    title.TextColor3 = Color3.new(1,1,1)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 20
    title.Parent = frame

    for i, data in ipairs(scriptList) do
        local button = Instance.new("TextButton")

        button.Size = UDim2.new(1, -20, 0, 35)
        button.Position = UDim2.new(0, 10, 0, 45 + ((i - 1) * 40))

        button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        button.TextColor3 = Color3.new(1,1,1)

        button.Font = Enum.Font.Gotham
        button.TextSize = 16

        button.Text = data.name

        button.Parent = frame

        local bCorner = Instance.new("UICorner")
        bCorner.CornerRadius = UDim.new(0, 8)
        bCorner.Parent = button

        button.MouseButton1Click:Connect(function()
            gui:Destroy()
            loadScript(data.url, data.name)
        end)
    end
end



local placeId = game.PlaceId
local gameId = game.GameId

print("PlaceId:", placeId)
print("GameId:", gameId)

if setclipboard then
    setclipboard(tostring(gameId))
    print("Copied GameId to clipboard.")
end

local scriptsForHere =
    PLACE_SCRIPTS[placeId]
    or GAME_SCRIPTS[gameId]

if scriptsForHere then

    if scriptsForHere[1] and not scriptsForHere[2] then
        loadScript(
            scriptsForHere[1].url,
            scriptsForHere[1].name
        )
    else
        showSelectionUI(scriptsForHere)
    end

else
    print("[Zenith Hub] No game-specific script found.")
    print("[Zenith Hub] Loading universal fallback.")

    notify("Using universal script")

    loadScript(
        UNIVERSAL_URL,
        "Universal Script"
    )
end
